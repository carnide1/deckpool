# Optional: mirror that serves the same /images/cardlist/card/... paths as Bandai.
# Catalog + Firestore keep Bandai URLs. Browser tries mirror first, then Bandai.
# Must be a valid http(s) origin with no trailing slash (invalid values are ignored).
# NEXT_PUBLIC_CARD_IMAGE_ORIGIN=https://your-cdn.example.com
