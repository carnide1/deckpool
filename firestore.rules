rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function shareString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= maxLen;
    }

    function validCollectionItem() {
      return request.resource.data.keys().hasOnly([
          'quantity',
          'labels',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['labels'])
          || (
            request.resource.data.labels is list
            && request.resource.data.labels.size() <= 50
          ));
    }

    function validWantedItem() {
      return request.resource.data.keys().hasOnly([
          'quantity',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.updatedAt is timestamp;
    }

    function validCardPref() {
      return request.resource.data.keys().hasOnly(['preferredImageUrl'])
        && request.resource.data.preferredImageUrl is string
        && request.resource.data.preferredImageUrl.matches(
          'https://en\\.onepiece-cardgame\\.com/images/cardlist/card/[A-Za-z0-9][A-Za-z0-9._-]{0,38}\\.png'
        );
    }

    function validDeck() {
      return request.resource.data.keys().hasOnly([
          'name',
          'leaderId',
          'favoriteVariationId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.leaderId is string
        && request.resource.data.leaderId.size() > 0
        && request.resource.data.leaderId.size() <= 32
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['favoriteVariationId'])
          || request.resource.data.favoriteVariationId is string)
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp);
    }

    function validVariation() {
      return request.resource.data.keys().hasOnly([
          'name',
          'cards',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.cards is map
        && request.resource.data.cards.size() <= 60
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /collection/{cardId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCollectionItem();
        allow delete: if isOwner(uid);
      }
      match /cardPrefs/{cardId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCardPref();
        allow delete: if isOwner(uid);
      }
      match /wanted/{cardId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWantedItem();
        allow delete: if isOwner(uid);
      }
      match /decks/{deckId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDeck();
        allow delete: if isOwner(uid);
        match /variations/{variationId} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid) && validVariation();
          allow delete: if isOwner(uid);
        }
      }
    }

    // Public read-only deck list snapshots for SMS share links (/s/{id}).
    // Owner decks under users/{uid}/decks stay private.
    // get (single doc) is public; list is denied so shares are not a browsable gallery.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'deckId',
          'variationId',
          'deckName',
          'leaderId',
          'variationName',
          'cards',
          'preferredImages',
          'createdAt',
          'updatedAt'
        ])
        && shareString('deckName', 120)
        && shareString('leaderId', 32)
        && shareString('variationName', 80)
        && request.resource.data.deckId is string
        && request.resource.data.deckId.size() > 0
        && request.resource.data.deckId.size() <= 64
        && request.resource.data.variationId is string
        && request.resource.data.variationId.size() > 0
        && request.resource.data.variationId.size() <= 64
        && request.resource.data.cards is map
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 60
        && request.resource.data.preferredImages is map
        && request.resource.data.preferredImages.size() <= 61;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
