rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Mirrors lib/friendIds.ts friendshipId.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriend(uid) {
      return request.auth != null
        && request.auth.uid != uid
        && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)));
    }

    // Missing profile => get() fails => denied (privacy fails closed).
    function sharesArea(uid, area) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data.privacy[area] == true;
    }

    function friendCanRead(uid, area) {
      return isFriend(uid) && sharesArea(uid, area);
    }

    // Mirrors lib/usernames.ts USERNAME_PATTERN + RESERVED_USERNAMES.
    function validUsername(name) {
      return name is string
        && name.matches('^[a-z0-9][a-z0-9_.]{2,19}$')
        && !(name in [
          'admin', 'deckpool', 'support', 'help', 'mod',
          'moderator', 'system', 'null', 'undefined'
        ]);
    }

    function validPublicProfile(uid) {
      let d = request.resource.data;
      let fields = ['username', 'displayName', 'privacy', 'updatedAt'];
      let areas = ['decks', 'collection', 'wanted'];
      return d.keys().hasOnly(fields)
        && d.keys().hasAll(fields)
        && validUsername(d.username)
        && d.displayName is string
        && d.displayName.size() <= 80
        && d.privacy is map
        && d.privacy.keys().hasOnly(areas)
        && d.privacy.keys().hasAll(areas)
        && d.privacy.decks is bool
        && d.privacy.collection is bool
        && d.privacy.wanted is bool
        && d.updatedAt is timestamp
        && getAfter(/databases/$(database)/documents/usernames/$(d.username)).data.uid == uid;
    }

    function shareString(field, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= maxLen;
    }

    function validUserProfileCreate() {
      return request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.createdAt is timestamp;
    }

    function validUserProfileUpdate() {
      return validUserProfileCreate()
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validCollectionItem() {
      return request.resource.data.keys().hasOnly([
          'quantity',
          'labels',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['labels'])
          || (
            request.resource.data.labels is list
            && request.resource.data.labels.size() <= 50
          ));
    }

    function validWantedItem() {
      return request.resource.data.keys().hasOnly([
          'quantity',
          'updatedAt'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.updatedAt is timestamp;
    }

    function validCardPref() {
      return request.resource.data.keys().hasOnly(['preferredImageUrl'])
        && request.resource.data.preferredImageUrl is string
        && request.resource.data.preferredImageUrl.matches(
          'https://en\\.onepiece-cardgame\\.com/images/cardlist/card/[A-Za-z0-9][A-Za-z0-9._-]{0,38}\\.png'
        );
    }

    function validDeck() {
      return request.resource.data.keys().hasOnly([
          'name',
          'leaderId',
          'favoriteVariationId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.leaderId is string
        && request.resource.data.leaderId.size() > 0
        && request.resource.data.leaderId.size() <= 32
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['favoriteVariationId'])
          || request.resource.data.favoriteVariationId is string)
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp);
    }

    // cards map values (positive ints) are cleaned client-side (cleanCardsMap).
    // Rules cannot iterate dynamic map values; size + keys are enforced here.
    function validVariation() {
      return request.resource.data.keys().hasOnly([
          'name',
          'cards',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.cards is map
        && request.resource.data.cards.size() <= 60
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUserProfileCreate();
      allow update: if isOwner(uid) && validUserProfileUpdate();
      allow delete: if isOwner(uid);
      match /collection/{cardId} {
        allow read: if isOwner(uid) || friendCanRead(uid, 'collection');
        allow create, update: if isOwner(uid) && validCollectionItem();
        allow delete: if isOwner(uid);
      }
      match /cardPrefs/{cardId} {
        allow read: if isOwner(uid) || isFriend(uid);
        allow create, update: if isOwner(uid) && validCardPref();
        allow delete: if isOwner(uid);
      }
      match /wanted/{cardId} {
        allow read: if isOwner(uid) || friendCanRead(uid, 'wanted');
        allow create, update: if isOwner(uid) && validWantedItem();
        allow delete: if isOwner(uid);
      }
      match /decks/{deckId} {
        allow read: if isOwner(uid) || friendCanRead(uid, 'decks');
        allow create, update: if isOwner(uid) && validDeck();
        allow delete: if isOwner(uid);
        match /variations/{variationId} {
          allow read: if isOwner(uid) || friendCanRead(uid, 'decks');
          allow create, update: if isOwner(uid) && validVariation();
          allow delete: if isOwner(uid);
        }
      }
    }

    // Username reservations. get = exact lookup; list denied so there is no user directory.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Friend-readable profile (never the email). Username must be claimed in the
    // same write; a changed username must release the old reservation.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isFriend(uid);
      allow create: if isOwner(uid) && validPublicProfile(uid);
      allow update: if isOwner(uid)
        && validPublicProfile(uid)
        && (request.resource.data.username == resource.data.username
          || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)));
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read, delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'fromUid',
          'toUid',
          'fromUsername',
          'fromDisplayName',
          'toUsername',
          'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid.size() > 0
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && validUsername(request.resource.data.toUsername)
        && validUsername(request.resource.data.fromUsername)
        && request.resource.data.fromDisplayName is string
        && request.resource.data.fromDisplayName.size() <= 80
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.toUsername)).data.uid == request.resource.data.toUid
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username == request.resource.data.fromUsername
        && !exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, request.resource.data.toUid)))
        && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.auth.uid));
      allow update: if false;
    }

    // Created by the recipient of a pending request (exists() sees pre-batch data,
    // so the request can be deleted in the same batch).
    match /friendships/{friendshipId} {
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && friendshipId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/friendRequests/$(
          (request.resource.data.members[0] == request.auth.uid
            ? request.resource.data.members[1]
            : request.resource.data.members[0]) + '_' + request.auth.uid));
      allow update: if false;
    }

    // Public read-only deck list snapshots for SMS share links (/s/{id}).
    // Owner decks under users/{uid}/decks stay private.
    // get (single doc) is public; list is denied so shares are not a browsable gallery.
    // cards / preferredImages map *values* are sanitized by the client on write and parse.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'deckId',
          'variationId',
          'deckName',
          'leaderId',
          'variationName',
          'cards',
          'preferredImages',
          'createdAt',
          'updatedAt'
        ])
        && shareString('deckName', 120)
        && shareString('leaderId', 32)
        && shareString('variationName', 80)
        && request.resource.data.deckId is string
        && request.resource.data.deckId.size() > 0
        && request.resource.data.deckId.size() <= 64
        && request.resource.data.variationId is string
        && request.resource.data.variationId.size() > 0
        && request.resource.data.variationId.size() <= 64
        && request.resource.data.cards is map
        && request.resource.data.cards.size() > 0
        && request.resource.data.cards.size() <= 60
        && request.resource.data.preferredImages is map
        && request.resource.data.preferredImages.size() <= 61
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
